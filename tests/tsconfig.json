{
  "compilerOptions": {
    "module": "nodenext",
    "target": "esnext",
    "types": ["node", "vitest/globals"],
    "strict": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "skipLibCheck": true,
    "noEmit": true
  },
  "files": [
    "unit/cli/init.test.ts",
    "unit/cli/database-errors.test.ts",
    "unit/cli/migrate.test.ts",
    "unit/cli/doctor.test.ts"
  ]
}
